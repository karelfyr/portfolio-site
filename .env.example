# Copy to .env for local use, and add the same values in Railway → your service → Variables.
# Without the Google / Resend values the server runs in DEMO mode (no calendar, emails printed to the console).

# Google Calendar — OAuth client of type "Desktop app" (see docs/booking-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From: npm run google:auth
GOOGLE_REFRESH_TOKEN=
# Where bookings are created ("primary" = your main calendar)
GOOGLE_CALENDAR_ID=primary
# Calendars that block time (comma-separated). Add work / personal calendars you share with this account.
GOOGLE_BUSY_CALENDAR_IDS=primary

# Email — resend.com API key
RESEND_API_KEY=
# Where notifications go
NOTIFY_EMAIL=karelfyrbach@gmail.com
# Sender. onboarding@resend.dev only delivers to your own Resend login email.
# With a verified domain, use e.g. "Karel Fyrbach <hello@yourdomain.com>" – visitors then also get a confirmation.
MAIL_FROM=Portfolio <onboarding@resend.dev>

# Booking rules (host time zone)
HOST_TIMEZONE=America/New_York
CALL_MINUTES=20
DAY_START_HOUR=10
DAY_END_HOUR=18
LUNCH_START_HOUR=13
LUNCH_END_HOUR=14
BOOKING_WEEKDAYS=1,2,3,4,5
NOTICE_HOURS=12
HORIZON_DAYS=60
BUFFER_MINUTES=10
CALL_TITLE=Intro call
